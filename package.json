{
  "name": "kirari",
  "private": true,
  "type": "module",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markd3ng/KIRARI.git"
  },
  "bugs": {
    "url": "https://github.com/markd3ng/KIRARI/issues"
  },
  "homepage": "https://github.com/markd3ng/KIRARI#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "site:dev": "\"$npm_execpath\" --filter @kirari/site dev",
    "site:build": "\"$npm_execpath\" --filter @kirari/site build",
    "site:type-check": "\"$npm_execpath\" --filter @kirari/site type-check",
    "site:astro-check": "\"$npm_execpath\" --filter @kirari/site check",
    "edge:type-check": "\"$npm_execpath\" --filter @kirari/edge type-check",
    "edge:test": "\"$npm_execpath\" --filter @kirari/edge test",
    "edge:deploy:dry": "\"$npm_execpath\" --filter @kirari/edge deploy:dry",
    "edge:deploy": "\"$npm_execpath\" --filter @kirari/edge deploy",
    "gateway:type-check": "\"$npm_execpath\" --filter @kirari/edge-gateway-core type-check",
    "gateway:test": "\"$npm_execpath\" --filter @kirari/edge-gateway-core test",
    "deploy:config:check": "node apps/site/scripts/generate-vercel-config.mjs --check",
    "profile:check": "node scripts/check-profile-materialization.mjs",
    "site:profile:check": "node apps/site/scripts/check-site-profile.mjs",
    "site:contract:check": "node apps/site/scripts/check-site-contract-v2.mjs",
    "site:contract:test": "node --test apps/site/scripts/tests/site-contract-v2.test.mjs",
    "site:profile:migrate:v2": "node apps/site/scripts/migrate-site-profile-v1-to-v2.mjs",
    "site:test": "\"$npm_execpath\" --filter @kirari/site test",
    "composition:test": "node --test apps/site/scripts/tests/composition-provenance.test.mjs scripts/tests/composed-build.test.mjs scripts/tests/ci-composed-artifact-contract.test.mjs",
    "trellis:check": "node scripts/check-trellis-adapter-sync.mjs",
    "release:check": "node scripts/release-regression-check.mjs",
    "release:version-check": "node scripts/release-version-check.mjs",
    "check": "\"$npm_execpath\" site:type-check && \"$npm_execpath\" site:astro-check && \"$npm_execpath\" edge:type-check && \"$npm_execpath\" edge:test && \"$npm_execpath\" gateway:type-check && \"$npm_execpath\" gateway:test && \"$npm_execpath\" gateway:vercel:type-check && \"$npm_execpath\" gateway:vercel:test && \"$npm_execpath\" gateway:edgeone:type-check && \"$npm_execpath\" gateway:edgeone:test && \"$npm_execpath\" profile:check && \"$npm_execpath\" trellis:check",
    "build": "\"$npm_execpath\" site:build",
    "audit": "\"$npm_execpath\" --filter @kirari/site audit",
    "gateway:edgeone:type-check": "\"$npm_execpath\" --filter @kirari/edge-gateway-edgeone type-check",
    "gateway:edgeone:test": "\"$npm_execpath\" --filter @kirari/edge-gateway-edgeone test",
    "gateway:edgeone:package": "\"$npm_execpath\" --filter @kirari/edge-gateway-edgeone package",
    "gateway:vercel:type-check": "\"$npm_execpath\" --filter @kirari/edge-gateway-vercel type-check",
    "gateway:vercel:test": "\"$npm_execpath\" --filter @kirari/edge-gateway-vercel test"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "brace-expansion@^2.0.0": "2.1.7",
      "devalue": "5.9.3",
      "esbuild": "0.28.1",
      "fflate@^0.7.0": "0.7.5",
      "fast-uri@^3.0.0": "3.1.8",
      "immutable@^4.0.0": "4.3.9",
      "js-yaml": "4.3.2",
      "katex": "0.18.7",
      "linkify-it@^5.0.0": "5.0.2",
      "nanoid@^3.0.0": "3.3.19",
      "postcss@^8.0.0": "8.5.28",
      "postcss-selector-parser": "7.1.6",
      "svgo@^4.0.0": "4.1.0",
      "sharp": "0.35.5",
      "undici": "7.30.0",
      "vite": "8.3.5",
      "ws": "8.21.0",
      "yaml": "2.9.0"
    }
  },
  "devDependencies": {
    "parse5": "7.3.0"
  },
  "dependencies": {
    "@kirari/edge-gateway-vercel": "workspace:*"
  }
}
