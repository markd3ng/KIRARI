    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.18.1",
    "satori": "^0.63.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.0",
