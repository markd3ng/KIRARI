    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.1.0",
    "@docsearch/css": "^4.7.1",
    "@docsearch/js": "^4.7.1",
    "@expressive-code/core": "^0.44.1",
