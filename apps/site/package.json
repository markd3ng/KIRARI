{
  "name": "@kirari/site",
  "private": true,
  "type": "module",
  "version": "0.5.1",
  "scripts": {
    "dev": "node scripts/materialize-profile.mjs && astro dev",
    "build": "node scripts/materialize-profile.mjs && node scripts/materialize-ghc-adapter.mjs && node node_modules/astro/bin/astro.mjs build --mode production && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "node scripts/materialize-profile.mjs && astro sync && tsc --noEmit",
    "check": "node scripts/materialize-profile.mjs && astro check",
    "test": "node --test --test-concurrency=1 scripts/tests/*.test.mjs",
    "audit": "pnpm audit --audit-level moderate",
    "new-post": "node scripts/new-post.js",
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "prepare": "node scripts/prepare-skilld.mjs"
  },
  "dependencies": {
