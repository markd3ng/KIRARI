---
import type { AnalyticsConfig } from "../types/config";

interface Props {
	config: AnalyticsConfig;
}

const { config } = Astro.props;
---

<div id="kirari-analytics-config" data-config={JSON.stringify(config)} hidden></div>

<script>
	import { initializeAnalytics } from "../utils/analytics-client";

	initializeAnalytics();
</script>
