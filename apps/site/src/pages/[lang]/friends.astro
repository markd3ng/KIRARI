---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import FriendLinksPanel from "@components/friends/FriendLinksPanel.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getLocalizedSpecEntry } from "@utils/spec-content";
import friendsItems from "../../_data/friends.json";
import { getLocalizedRouteContext, getPrefixedStaticPaths } from "../../utils/page-route-utils";

export const getStaticPaths = getPrefixedStaticPaths satisfies GetStaticPaths;

const { lang, currentUrl, alternates } = getLocalizedRouteContext("/friends/", Astro.params.lang);
const friendsPage = await getLocalizedSpecEntry("friends", lang);
if (!friendsPage) throw new Error("Friends page content not found");
const { Content } = await render(friendsPage);
const items = friendsItems;
---

<MainGridLayout title={i18n(I18nKey.friends, lang)} description={i18n(I18nKey.friends, lang)} lang={lang} alternates={alternates} canonicalUrl={currentUrl}>
	<FriendLinksPanel items={items} lang={lang} />
	<div class="card-base mt-6 px-6 py-6 sm:px-9">
		<Markdown class="">
			<Content />
		</Markdown>
	</div>
</MainGridLayout>
