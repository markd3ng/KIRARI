{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "test"]
}
